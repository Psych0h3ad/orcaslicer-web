{
  "name": "orcaslicer-web-pages",
  "version": "0.1.0",
  "description": "Unofficial OrcaSlicer WebAssembly app for GitHub Pages and iPad, based on CubbySlicer.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://psych0h3ad.github.io/orcaslicer-web/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Psych0h3ad/orcaslicer-web.git"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/stage-pages-assets.mjs",
    "assets:verify": "node scripts/stage-pages-assets.mjs --verify",
    "prebuild": "npm run assets && node scripts/prepare-pages.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:engine": "node scripts/test-pages-engine.mjs",
    "test:engine:mt": "node scripts/test-pages-engine.mjs --mt",
    "test:threads": "node scripts/test-pages-threads.mjs --engine"
  },
  "dependencies": {
    "@cubby/shared": "git+https://github.com/JoshTheDerf/cubby-shared.git#38a54358e2ae740cbe3baf867952db65990db928",
    "@nuxt/ui": "^4.11.2",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0",
    "occt-import-js": "^0.0.23",
    "opentype.js": "^2.0.0",
    "pyodide": "0.27.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.182.0",
    "three-viewport-gizmo": "^2.2.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@types/node": "^24.10.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "fflate": "^0.8.3",
    "playwright": "^1.59.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "fontless": {
      "esbuild": "^0.28.1"
    }
  }
}
